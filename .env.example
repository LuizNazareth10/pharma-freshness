# Copie este arquivo para .env antes de iniciar o ambiente.
# Estas credenciais são APENAS para desenvolvimento local.
MINIO_ROOT_USER=pharma_admin
MINIO_ROOT_PASSWORD=pharma-local-2026-change-me

# Recursos e portas do laboratório
MINIO_BUCKET=farmacovigilancia
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# APIs e ingestao batch (Fase 2)
# A chave openFDA nao e obrigatoria no laboratorio, mas aumenta a cota diaria.
OPENFDA_API_KEY=
DAILYMED_INITIAL_DATE=2026-07-20
FAERS_INITIAL_DATE=2026-03-31
RES_INITIAL_DATE=2026-07-01
# Rele ultimos 90 dias porque status/motivo de um recall antigo pode mudar.
RES_LOOKBACK_DAYS=90

# Configuracao local do lakehouse
MINIO_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
ICEBERG_WAREHOUSE_PREFIX=iceberg

# Modelagem e normalizacao (Fase 3)
# RXNORM_OFFLINE=1 usa apenas o cache local e nao chama o RxNav. Util sem internet ou para
# tornar uma execucao totalmente reproduzivel; nomes ainda nao consultados ficam nao mapeados.
RXNORM_OFFLINE=0
# Teto de consultas NOVAS ao RxNav por execucao. Freia o caso em que uma ingestao muito maior
# que a esperada viraria milhares de chamadas sem ninguem ter decidido isso. O cache e
# persistente, entao os nomes restantes sao resolvidos nas execucoes seguintes.
RXNORM_MAX_LOOKUPS=500

# Orquestracao (Fase 4)
# O Airflow so sobe com `docker compose --profile orquestracao up -d`.
# 8081 e nao 8080: o proprio Docker Desktop costuma manter a 8080 ocupada no Windows.
AIRFLOW_PORT=8081
# Credenciais do console web. Sao de laboratorio: o Airflow fica exposto apenas em localhost.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
